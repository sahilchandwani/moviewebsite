<%- include('partials/head', { title: 'Unlock ' + movie.title }) %>

<section class="buy-section">
  <div class="buy-section__backdrop" style="background-image: url('<%= movie.poster_path %>')"></div>
  <div class="buy-section__scrim"></div>
  <div class="wrap">
    <div class="buy-card">
      <img class="buy-card__poster" src="<%= movie.poster_path %>" alt="<%= movie.title %> poster" />
      <div class="buy-card__body">
        <h1>Unlock <%= movie.title %></h1>
        <p class="tagline"><%= movie.tagline %></p>
        <p><%= movie.description %></p>
        <p class="price">
          <%= (movie.price_paise / 100).toFixed(2) %> <%= movie.currency %>
          <span class="muted">one-time purchase &middot; watch anytime on this site</span>
        </p>
        <p id="buy-error" class="alert alert--error" hidden></p>
        <button id="pay-button" class="btn btn--full" data-slug="<%= movie.slug %>">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 17a2 2 0 0 0 2-2 2 2 0 0 0-2-2 2 2 0 0 0-2 2 2 2 0 0 0 2 2zm6-9h-1V6a5 5 0 0 0-10 0v2H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V10a2 2 0 0 0-2-2zM8.9 6A3.1 3.1 0 0 1 12 2.9 3.1 3.1 0 0 1 15.1 6v2H8.9z"/></svg>
          Pay &amp; unlock
        </button>
        <p class="trust-row">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 1 3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/></svg>
          Payments processed securely by Razorpay. We never see or store your card details.
        </p>
      </div>
    </div>
  </div>
</section>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script src="/public/js/buy.js"></script>

<%- include('partials/footer') %>
