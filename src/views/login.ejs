<%- include('partials/head', { title: 'Log in' }) %>

<section class="wrap auth-section">
  <div class="auth-card">
    <h1>Log in</h1>
    <% if (error) { %>
      <p class="alert alert--error"><%= error %></p>
    <% } %>
    <form action="/login" method="post" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <label>
        Email
        <input type="email" name="email" required autocomplete="email" value="<%= values.email || '' %>" />
      </label>
      <label>
        Password
        <input type="password" name="password" required autocomplete="current-password" />
      </label>
      <button type="submit" class="btn btn--full">Log in</button>
    </form>
    <p class="auth-switch">New here? <a href="/register">Create an account</a></p>
  </div>
</section>

<%- include('partials/footer') %>
