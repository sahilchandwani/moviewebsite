<%- include('partials/head', { title: 'Sign up' }) %>

<section class="wrap auth-section">
  <div class="auth-card">
    <h1>Create your account</h1>
    <% if (errors && errors.length) { %>
      <ul class="alert alert--error">
        <% errors.forEach(function(e) { %><li><%= e %></li><% }) %>
      </ul>
    <% } %>
    <form action="/register" method="post" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <label>
        Name
        <input type="text" name="name" required minlength="2" maxlength="80" value="<%= values.name || '' %>" />
      </label>
      <label>
        Email
        <input type="email" name="email" required autocomplete="email" value="<%= values.email || '' %>" />
      </label>
      <label>
        Password
        <input type="password" name="password" required minlength="10" autocomplete="new-password" />
      </label>
      <label>
        Confirm password
        <input type="password" name="confirmPassword" required minlength="10" autocomplete="new-password" />
      </label>
      <p class="hint">At least 10 characters, with an uppercase letter, a lowercase letter and a number.</p>
      <button type="submit" class="btn btn--full">Sign up</button>
    </form>
    <p class="auth-switch">Already have an account? <a href="/login">Log in</a></p>
  </div>
</section>

<%- include('partials/footer') %>
