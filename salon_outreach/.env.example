# Copy this file to .env (in this salon_outreach/ folder) and fill in real
# values. Never commit .env.

# --- Stage 1: Apify (Instagram scraping) ---
APIFY_API_TOKEN=

# Optional overrides -- Apify actor IDs in "owner~actor-name" form. Apify
# actor input schemas change over time; if a run fails validation, check the
# actor's "Input" tab in the Apify Console and adjust stage1_scrape.py.
# APIFY_ACTOR_HASHTAG=apify~instagram-hashtag-scraper
# APIFY_ACTOR_PROFILE=apify~instagram-profile-scraper

# Keep this modest -- Instagram scraping via third-party tools sits in a
# gray area of Instagram's Terms of Service. Hard-capped at 100 regardless.
# SALON_SCRAPE_LIMIT=25

# --- Stage 2: Anthropic (message generation) ---
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-4-6

# --- Stage 3: Gmail drafts (optional) ---
# Leave both blank to skip Gmail entirely -- you'll just get the CSV plus a
# CLI checklist instead. See README.md for how to obtain client_secret.json.
# GMAIL_CREDENTIALS_PATH=./client_secret.json
# GMAIL_TOKEN_PATH=./gmail_token.json
