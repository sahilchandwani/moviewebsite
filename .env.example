# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
NODE_ENV=development
PORT=3000
# Public base URL of the site (used for absolute links, Razorpay callback checks, etc.)
BASE_URL=http://localhost:3000

# --- Secrets (generate long random strings, e.g. `openssl rand -hex 32`) ---
SESSION_SECRET=change-me-to-a-long-random-string
CSRF_SECRET=change-me-to-a-long-random-string
STREAM_TOKEN_SECRET=change-me-to-a-long-random-string

# --- Razorpay ---
# Get these from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Configure a webhook in the Razorpay dashboard pointing to /payment/webhook
# and set the same secret here.
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Pricing ---
# Price to unlock the movie, in the smallest currency unit (paise). 19900 = INR 199.00
MOVIE_PRICE_PAISE=19900
MOVIE_CURRENCY=INR
